@TasksApi_HostAddress = http://localhost:5233

# Cómo usar este archivo:
# 1. Levanta la API:  dotnet run --project src/TasksApi --launch-profile http
# 2. Ejecuta primero "Crear una tarea". Las peticiones siguientes usan el id
#    que devolvió esa respuesta ({{createTask.response.body.$.id}}),
#    así que no hace falta cambiar ids a mano.
# 3. Si borras la tarea, vuelve a ejecutar "Crear una tarea" antes de seguir.

# ---------------------------------------------------------------
# Flujo normal (CRUD)
# ---------------------------------------------------------------

### Crear una tarea (201 + header Location)
# @name createTask
POST {{TasksApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Comprar leche",
  "description": "Dos litros"
}

### Listar todas las tareas (200, lista vacía si no hay)
GET {{TasksApi_HostAddress}}/api/tasks
Accept: application/json

### Obtener la tarea creada (200)
GET {{TasksApi_HostAddress}}/api/tasks/{{createTask.response.body.$.id}}
Accept: application/json

### Actualizar la tarea creada (200)
PUT {{TasksApi_HostAddress}}/api/tasks/{{createTask.response.body.$.id}}
Content-Type: application/json

{
  "title": "Comprar leche deslactosada",
  "description": "Dos litros",
  "isCompleted": true
}

### Borrar la tarea creada (204; si se repite, 404)
DELETE {{TasksApi_HostAddress}}/api/tasks/{{createTask.response.body.$.id}}

# ---------------------------------------------------------------
# Tareas que no existen (404 con ProblemDetails)
# ---------------------------------------------------------------

### Obtener una tarea que no existe (404)
GET {{TasksApi_HostAddress}}/api/tasks/9999
Accept: application/json

### Actualizar una tarea que no existe (404)
PUT {{TasksApi_HostAddress}}/api/tasks/9999
Content-Type: application/json

{
  "title": "No existe",
  "isCompleted": false
}

### Borrar una tarea que no existe (404)
DELETE {{TasksApi_HostAddress}}/api/tasks/9999

# ---------------------------------------------------------------
# Datos inválidos (400 con ValidationProblemDetails)
# No dependen de ninguna tarea existente.
# ---------------------------------------------------------------

### Crear sin título (400, errors.Title)
POST {{TasksApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "description": "Sin título"
}

### Crear con título de solo espacios (400, errors.Title)
POST {{TasksApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "   "
}

### Crear con título de más de 200 caracteres (400, errors.Title)
POST {{TasksApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

### Crear con JSON mal escrito (400, falta la llave de cierre)
POST {{TasksApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "JSON roto"

### Actualizar sin isCompleted (400, errors.IsCompleted)
# La validación ocurre antes de buscar la tarea, por eso el id da igual.
PUT {{TasksApi_HostAddress}}/api/tasks/9999
Content-Type: application/json

{
  "title": "Falta el estado"
}

# ---------------------------------------------------------------
# Rutas y métodos inválidos (ProblemDetails)
# ---------------------------------------------------------------

### Ruta con id que no es número (404)
GET {{TasksApi_HostAddress}}/api/tasks/abc

### Método no permitido en la colección (405)
DELETE {{TasksApi_HostAddress}}/api/tasks

###
